{
    "name": "artnet-proto",
    "version": "1.1.0",
    "description": "A TypeScript library implementing the Art-Net protocol",
    "license": "MIT",
    "author": "Abdullah Waqar",
    "homepage": "https://github.com/abdullahwaqar/artnet-proto",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/abdullahwaqar/artnet-proto.git"
    },
    "keywords": [
        "artnet",
        "dmx",
        "dmx512",
        "rgb",
        "Art-Net"
    ],
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "default": "./lib/index.js"
        }
    },
    "files": [
        "lib/**/*",
        "CHANGELOG.md"
    ],
    "scripts": {
        "build": "tsc",
        "clean": "rm -rf lib",
        "typecheck": "tsc --noEmit -p tsconfig.check.json",
        "lint": "biome check src test examples",
        "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
        "prepublishOnly": "npm run clean && npm run lint && npm run typecheck && npm test && npm run build",
        "dev": "tsx examples/artnet-demo.ts",
        "demo:discover": "tsx examples/send-all.ts"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.2.0",
        "@types/node": "^24.2.1",
        "tsx": "^4.20.4",
        "typescript": "5.9"
    }
}
